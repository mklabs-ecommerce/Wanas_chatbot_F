# ---- Gemini (Google AI Studio free tier: https://aistudio.google.com) ----
GEMINI_API_KEY=
# Current latest stable Flash model on the free tier (verified 2026-08-17).
GEMINI_MODEL=gemini-3.7-flash
# Tried in order if the primary model is rate-limited or unavailable (JSON list).
# Each Gemini model has its own ~20-request free-tier budget, so more entries = more
# headroom before the bot has to fall back to a polite "try again shortly" reply.
# GEMINI_FALLBACK_MODELS=["gemini-3.6-flash","gemini-3.5-flash","gemini-2.5-flash","gemini-3.5-flash-lite","gemini-3.1-flash-lite"]
# Which model matches a customer's photo against the catalog. Leave empty to use whichever
# model answers the conversation. Worth setting when the chat model is chosen for speed:
# measured on this store's own product photos, gemini-3.1-flash-lite identified 1 of 3
# while gemini-3.5-flash-lite identified 3 of 3.
# GEMINI_VISION_MODEL=gemini-3.5-flash-lite
# Reply speed vs reasoning depth: low | medium | high ("minimal" is unsupported on 3.x flash).
# GEMINI_THINKING_LEVEL=low


# ---- Shopify ----
# Store domain only, e.g. wanas-gallery.myshopify.com
SHOPIFY_STORE=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07

# ---- Orders ----
# Require the customer to give the email or phone on an order before its status is
# revealed. Order numbers are sequential and easy to guess, so leaving this on is
# strongly recommended outside a closed test store.
# ORDERS_REQUIRE_CONTACT_VERIFICATION=true

# ---- Database ----
# Leave unset for local SQLite (./data/wanas.db); set a Postgres URL in production.
DATABASE_URL=

# ---- Email notifications (support tickets) ----
# Where a support ticket is emailed. Without these the ticket is still stored and the
# reference still given to the customer - it just waits in the database unseen, and the
# log says so loudly at WARNING.
# Gmail needs an App Password, not the account password: host smtp.gmail.com, port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
STORE_OWNER_EMAIL=
# Port 587 uses STARTTLS (the default). For port 465 set SMTP_USE_SSL=true.
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# ---- App ----
ENVIRONMENT=development
DEBUG=true
